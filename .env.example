# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/address_db?retryWrites=true&w=majority
DATABASE_NAME=address_db

# API Base URL for Mobile Native (Capacitor Android build)
# When building for Android APK, point this to your deployed Netlify functions URL or local network IP:
# e.g., VITE_API_BASE_URL=https://your-site.netlify.app/.netlify/functions
# or e.g., VITE_API_BASE_URL=http://192.168.1.100:3000/.netlify/functions
VITE_API_BASE_URL=
